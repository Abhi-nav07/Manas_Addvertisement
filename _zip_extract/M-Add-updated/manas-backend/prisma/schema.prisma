generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// AUTH / RBAC
// ─────────────────────────────────────────────

model Admin {
  id            String    @id @default(uuid())
  name          String
  email         String    @unique
  password      String
  roleId        String
  role          Role      @relation(fields: [roleId], references: [id])
  isActive      Boolean   @default(true)
  lastLoginAt   DateTime?
  refreshTokenHash String?
  resetToken    String?
  resetTokenExpiresAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
  activityLogs  ActivityLog[]

  @@index([roleId])
  @@map("admins")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique // super_admin, admin, editor, content_manager
  description String?
  admins      Admin[]
  permissions RolePermission[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("roles")
}

model Permission {
  id        String   @id @default(uuid())
  key       String   @unique // e.g. "services.create"
  description String?
  roles     RolePermission[]
  createdAt DateTime @default(now())

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// ─────────────────────────────────────────────
// CONTENT
// ─────────────────────────────────────────────

model Category {
  id        String     @id @default(uuid())
  name      String
  slug      String     @unique
  services  Service[]
  portfolio Portfolio[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  deletedAt DateTime?

  @@index([slug])
  @@map("categories")
}

model Service {
  id          String    @id @default(uuid())
  title       String
  slug        String    @unique
  description String
  icon        String?
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  status      Status    @default(PUBLISHED)
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([categoryId])
  @@index([status])
  @@map("services")
}

model Portfolio {
  id          String            @id @default(uuid())
  title       String
  slug        String            @unique
  description String
  clientName  String?
  categoryId  String?
  category    Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  status      Status            @default(PUBLISHED)
  images      PortfolioImage[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  deletedAt   DateTime?

  @@index([categoryId])
  @@index([status])
  @@map("portfolio")
}

model PortfolioImage {
  id          String    @id @default(uuid())
  portfolioId String
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  mediaFileId String
  mediaFile   MediaFile @relation(fields: [mediaFileId], references: [id], onDelete: Cascade)
  order       Int       @default(0)
  createdAt   DateTime  @default(now())

  @@index([portfolioId])
  @@map("portfolio_images")
}

model Gallery {
  id        String    @id @default(uuid())
  title     String
  mediaFileId String
  mediaFile MediaFile @relation(fields: [mediaFileId], references: [id], onDelete: Cascade)
  order     Int       @default(0)
  status    Status    @default(PUBLISHED)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("gallery")
}

model Testimonial {
  id        String    @id @default(uuid())
  clientName String
  clientRole String?
  message   String
  rating    Int       @default(5)
  clientId  String?
  client    Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  status    Status    @default(PUBLISHED)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([clientId])
  @@map("testimonials")
}

model Client {
  id          String        @id @default(uuid())
  name        String
  logoMediaId String?
  website     String?
  status      Status        @default(PUBLISHED)
  testimonials Testimonial[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?

  @@map("clients")
}

model Faq {
  id        String    @id @default(uuid())
  question  String
  answer    String
  order     Int       @default(0)
  status    Status    @default(PUBLISHED)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("faqs")
}

model HomepageContent {
  id        String   @id @default(uuid())
  section   String   @unique // hero, about, cta, etc.
  content   Json
  updatedAt DateTime @updatedAt

  @@map("homepage_content")
}

model SiteSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt

  @@map("site_settings")
}

model ContactEnquiry {
  id        String   @id @default(uuid())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String
  status    EnquiryStatus @default(NEW)
  createdAt DateTime @default(now())

  @@index([status])
  @@map("contact_enquiries")
}

model QuoteRequest {
  id          String   @id @default(uuid())
  name        String
  email       String
  phone       String?
  serviceInterested String?
  budget      String?
  message     String?
  status      EnquiryStatus @default(NEW)
  createdAt   DateTime @default(now())

  @@index([status])
  @@map("quote_requests")
}

model MediaFile {
  id           String   @id @default(uuid())
  fileName     String
  originalName String
  mimeType     String
  size         Int
  path         String
  thumbnailPath String?
  entityType   String?  // "portfolio" | "gallery" | "blog" | ...
  entityId     String?
  uploadedById String?
  createdAt    DateTime @default(now())
  deletedAt    DateTime?

  portfolioImages PortfolioImage[]
  galleryItems    Gallery[]

  @@index([entityType, entityId])
  @@map("media_files")
}

model SeoMetadata {
  id          String   @id @default(uuid())
  entityType  String
  entityId    String
  title       String?
  description String?
  keywords    String?
  ogImage     String?
  updatedAt   DateTime @updatedAt

  @@unique([entityType, entityId])
  @@map("seo_metadata")
}

model ActivityLog {
  id        String   @id @default(uuid())
  adminId   String?
  admin     Admin?   @relation(fields: [adminId], references: [id], onDelete: SetNull)
  action    String   // "services.create", "auth.login", etc.
  entityType String?
  entityId  String?
  metadata  Json?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([adminId])
  @@index([action])
  @@map("activity_logs")
}

enum Status {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum EnquiryStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  ARCHIVED
}
